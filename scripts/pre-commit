#!/bin/bash
# Linuxtrack Pre-commit Hook
# Runs optional C/C++ checks before each commit.
#
# To install: cp scripts/pre-commit .git/hooks/pre-commit && chmod +x .git/hooks/pre-commit

set -e

echo "🔍 Linuxtrack Pre-commit Checks..."

# Track if any optional checks were skipped
SKIPPED_CHECKS=""

# 1. CMake Build Check (if build directory exists)
if [ -d "build" ] && [ -f "build/Makefile" ]; then
    echo "  🔨 Running CMake build check..."
    BUILD_OUTPUT=$(cmake --build build --target ltr_gui -- -j$(nproc) 2>&1)
    BUILD_EXIT=$?
    if [ $BUILD_EXIT -ne 0 ]; then
        echo "$BUILD_OUTPUT" | tail -20
        echo "❌ CMake build failed. Fix errors before committing."
        exit 1
    fi
    echo "  ✅ CMake build check passed"
else
    SKIPPED_CHECKS="$SKIPPED_CHECKS cmake-build"
fi

# 2. clang-format check (optional - only if installed and .clang-format exists)
if command -v clang-format &> /dev/null && [ -f ".clang-format" ]; then
    echo "  🎨 Checking C/C++ format..."
    # Check only staged .c/.cpp/.h files
    STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACMR | grep -E '\.(c|cpp|h|hpp)$' || true)
    if [ ! -z "$STAGED_FILES" ]; then
        FORMAT_ISSUES=""
        for file in $STAGED_FILES; do
            if [ -f "$file" ]; then
                if ! clang-format --dry-run --Werror "$file" 2>/dev/null; then
                    FORMAT_ISSUES="$FORMAT_ISSUES $file"
                fi
            fi
        done
        if [ ! -z "$FORMAT_ISSUES" ]; then
            echo "⚠️  Format issues in:$FORMAT_ISSUES"
            echo "   Run: clang-format -i <file> to fix"
            # Warning only, don't block (legacy codebase)
        else
            echo "  ✅ Format check passed"
        fi
    fi
else
    SKIPPED_CHECKS="$SKIPPED_CHECKS clang-format"
fi

# 3. cppcheck (optional - only if installed)
if command -v cppcheck &> /dev/null; then
    echo "  📎 Running cppcheck on staged files..."
    STAGED_C_FILES=$(git diff --cached --name-only --diff-filter=ACMR | grep -E '\.(c|cpp)$' | head -20 || true)
    if [ ! -z "$STAGED_C_FILES" ]; then
        # Run cppcheck with limited output
        cppcheck --quiet --error-exitcode=0 --enable=warning $STAGED_C_FILES 2>&1 | head -20 || true
        echo "  ✅ cppcheck completed (warnings only, non-blocking)"
    fi
else
    SKIPPED_CHECKS="$SKIPPED_CHECKS cppcheck"
fi

# 4. Check for debug code that shouldn't be committed
echo "  🔎 Checking for debug artifacts..."
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACMR | grep -E '\.(c|cpp|h)$' || true)
if [ ! -z "$STAGED_FILES" ]; then
    # Look for common debug patterns
    if grep -l "printf.*DEBUG\|#if 0\|TODO.*REMOVE\|FIXME.*BEFORE.*COMMIT" $STAGED_FILES 2>/dev/null; then
        echo "  ⚠️  Potential debug code found (review before committing)"
    fi
fi

# Summary
if [ ! -z "$SKIPPED_CHECKS" ]; then
    echo ""
    echo "ℹ️  Skipped optional checks (tools not available):$SKIPPED_CHECKS"
fi

echo ""
echo "✅ Pre-commit checks completed!"
