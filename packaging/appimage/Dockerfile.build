# Hermetic Build Environment for Linuxtrack AppImage
# Base on Ubuntu 22.04 (Jammy) for Qt6 support and broad glibc compatibility (v2.35)
FROM ubuntu:22.04

LABEL maintainer="Linuxtrack Team"
LABEL description="Build environment for Linuxtrack with broad linux compatibility"

# Avoid interactive prompts
ENV DEBIAN_FRONTEND=noninteractive

# Install build dependencies
RUN apt-get update && apt-get install -y \
    build-essential \
    cmake \
    git \
    wget \
    pkg-config \
    libusb-1.0-0-dev \
    libv4l-dev \
    libmxml-dev \
    libgl1-mesa-dev \
    libglu1-mesa-dev \
    libglib2.0-dev \
    libgtk-3-dev \
    libopencv-dev \
    libvulkan-dev \
    zlib1g-dev \
    libxkbcommon-dev \
    libx11-dev \
    libxtst-dev \
    libxrender-dev \
    liblo-dev \
    flex \
    bison \
    nlohmann-json3-dev \
    qt6-base-dev \
    qt6-tools-dev \
    libqt6core6 \
    libqt6widgets6 \
    libqt6gui6 \
    libxcb-cursor-dev \
    libxcb-icccm4-dev \
    libxcb-keysyms1-dev \
    libxcb-randr0-dev \
    libxcb-render-util0-dev \
    libxcb-xinerama0-dev \
    python3 \
    bc \
    gcc-multilib \
    g++-multilib \
    gcc-mingw-w64-i686 \
    # Needed for AppImage generation
    file \
    binutils \
    && rm -rf /var/lib/apt/lists/*

# Set working directory
WORKDIR /build

# Default command (build)
CMD ["/bin/bash", "-c", "mkdir -p build && cd build && cmake .. && make -j$(nproc) && ../packaging/appimage/make_appimage.sh"]
