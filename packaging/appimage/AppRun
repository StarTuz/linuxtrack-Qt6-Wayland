#!/bin/bash
# AppRun wrapper for Linuxtrack AppImage
# Sets environment variables BEFORE Qt libraries are loaded

SELF=$(readlink -f "$0")
HERE=${SELF%/*}

# Avoid forcing software rendering by default, as it breaks modern OpenGL/Shaders
# in the 3D cockpit view. Let the system decide the best backend.
# export QSG_RHI_BACKEND=software
# export LIBGL_ALWAYS_SOFTWARE=1

# Use Fusion style which doesn't rely on platform-specific rendering
export QT_STYLE_OVERRIDE=Fusion

# Set library paths
export LD_LIBRARY_PATH="${HERE}/usr/lib:${HERE}/usr/lib/linuxtrack:${LD_LIBRARY_PATH}"

# Set Qt plugin paths - include both locations
export QT_PLUGIN_PATH="${HERE}/usr/plugins:${HERE}/usr/lib/qt6/plugins"
export QT_QPA_PLATFORM_PLUGIN_PATH="${HERE}/usr/plugins/platforms:${HERE}/usr/lib/qt6/plugins/platforms"

# Run the actual binary
exec "${HERE}/usr/bin/ltr_gui" "$@"
