# TrackIR / SmartNav USB device permissions
# Works on modern Arch/EndeavourOS with systemd uaccess
# Install to: /etc/udev/rules.d/99-TIR.rules

# TrackIR and SmartNav devices (NaturalPoint vendor ID 131d)
SUBSYSTEM=="usb", ATTR{idVendor}=="131d", MODE="0666", GROUP="users", TAG+="uaccess"

# Specific device nodes for completeness
SUBSYSTEM=="usb_device", ATTRS{idVendor}=="131d", MODE="0666", GROUP="users", TAG+="uaccess"
